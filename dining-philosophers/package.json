{
  "name": "nexus-dining-philosophers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React + Nexus demonstration consuming the packaged Nexus release",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:model": "tsc -p tsconfig.model.json && node tests/run.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "nexus": "file:../nexus-0.1.20.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
